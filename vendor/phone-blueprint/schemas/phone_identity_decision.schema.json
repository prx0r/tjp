{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhoneIdentityDecision",
  "type": "object",
  "required": [
    "business_id",
    "strategy",
    "candidates",
    "requires_confirmation"
  ],
  "properties": {
    "business_id": {
      "type": "string"
    },
    "strategy": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3
    },
    "requires_confirmation": {
      "const": true
    },
    "reservation_policy": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}